---
// EsaiCepat tokens — palet seed: mid / triadic / baseHue 323.
// Font via Astro Fonts API: --font-display (Sassy Frass), --font-body (Commissioner), --font-hand (Comic Neue).
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-body);
    --aw-font-serif: var(--font-body);
    --aw-font-heading: var(--font-display);

    --ec-bg: oklch(0.72 0.142 323);
    --ec-surface: oklch(0.6 0.11 323);
    --ec-text: oklch(0.16 0.03 323);
    --ec-muted: oklch(0.25 0.04 323);
    --ec-accent: oklch(0.7 0.199 83);
    --ec-accent-2: oklch(0.64 0.19 203);
    --ec-pop: oklch(0.79 0.212 165);

    --aw-color-primary: oklch(0.5 0.16 203);
    --aw-color-secondary: oklch(0.45 0.15 203);
    --aw-color-accent: oklch(0.7 0.199 83);

    --aw-color-text-heading: var(--ec-text);
    --aw-color-text-default: var(--ec-text);
    --aw-color-text-muted: var(--ec-muted);
    --aw-color-bg-page: var(--ec-bg);

    --aw-color-bg-page-dark: oklch(0.16 0.03 323);

    ::selection {
      background-color: var(--ec-accent);
      color: var(--ec-text);
    }
  }

  .dark {
    --aw-font-sans: var(--font-body);
    --aw-font-serif: var(--font-body);
    --aw-font-heading: var(--font-display);

    --aw-color-text-heading: oklch(0.94 0.02 323);
    --aw-color-text-default: oklch(0.9 0.03 323);
    --aw-color-text-muted: oklch(0.72 0.04 323);
    --aw-color-bg-page: oklch(0.16 0.03 323);
  }
</style>
